[Unit]
Description=AetherOS Computer Vision & Biometric Sensory Daemon
After=network.target aether-mcp.service
Wants=aether-mcp.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/bin/aether-visiond
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
