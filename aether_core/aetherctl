def cmd_intent(subargs):
    prompt = " ".join(subargs) if subargs else "diagnose system"
    res = send_unix_request(INTENT_SOCK, {"action": "route", "prompt": prompt})
    if not res:
        print("[aetherctl] Error: aether-intentd is not responding.")
        return
    print(f"[*] Prompt:       '{res.get('prompt')}'")
    print(f"[*] Resolved:     {res.get('intent')} (Tier: {res.get('tier')})")
    print(f"[*] Action:       {res.get('action')}")
    print(f"[*] Latency:      {res.get('latency_ms')}ms")
    print(f"[*] Result:       {res.get('result')}")

def cmd_chat(prompt):
    res = send_unix_request(INTENT_SOCK, {"action": "route", "prompt": prompt})
    if res:
        print(f"\n[Aether Intent]: {res.get('intent')} (Tier: {res.get('tier')}, {res.get('latency_ms')}ms)")
        print(f"[Aether Brain]:  {res.get('result')}\n")
        text = str(res.get('result'))
        if len(text) < 120 and "PSI Pressure" not in text:
            send_unix_request(VOICE_SOCK, {"action": "speak", "text": text})
    else:
        print("[aetherctl] Unable to connect to Intent Engine.")

