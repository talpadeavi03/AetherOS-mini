def main():
    if len(sys.argv) < 2:
        cmd_status()
        print("Commands:")
        print("  aetherctl holo              Launch 3D Volumetric Hologram Engine (Arc Reactor / Radar / LiDAR)")
        print("  aetherctl jarvis \"<query>\"  Direct full-duplex conversational voice query to J.A.R.V.I.S.")
        print("  aetherctl status            Show unified sensory, swarm & robotics health")
        print("  aetherctl robot [cmd]       Inspect or actuate Robotics & Sensor Fusion Hub")
        print("  aetherctl agent [cmd]       Inspect or command Autonomous Agent Swarm (heal/status/devops)")
        print("  aetherctl mlops [cmd]       Inspect MLOps model registry & hardware benchmarks")
        print("  aetherctl assist \"<query>\"  Terminal AI copilot for natural language commands")
        print("  aetherctl fix               Analyze last shell failure and generate resolution")
        print("  aetherctl git               Auto-generate conventional git commit message")
        print("  aetherctl hud               Launch Spatial Neural HUD")
        print("  aetherctl test              Run automated subsystem verification test suite")
        print("  aetherctl vision            Inspect real-time gaze, fatigue & biometrics")
        print("  aetherctl voice speak <t>   Synthesize speech via neural/phonetic TTS")
        print("  aetherctl memory store <c>  Store episodic note in vector vault")
        print("  aetherctl memory search <q> Query memory using cosine vector search")
        print("  aetherctl memory graph      Inspect user & system knowledge graph")
        print("  aetherctl intent <prompt>   Route natural language intent (<15ms)")
        print("  aetherctl compact           Trigger kernel memory compaction")
        return

    cmd = sys.argv[1]
    if cmd == "status":
        cmd_status()
    elif cmd in ["holo", "hologram"]:
        cmd_holo(sys.argv[2:])
    elif cmd in ["jarvis", "stark"]:
        cmd_jarvis(sys.argv[2:])
    elif cmd in ["robot", "robotics"]:
        cmd_robot(sys.argv[2:])
    elif cmd == "agent":
        cmd_agent(sys.argv[2:])
    elif cmd == "mlops":
        cmd_mlops(sys.argv[2:])
    elif cmd == "assist":
        cmd_assist(sys.argv[2:])
    elif cmd == "fix":
        cmd_fix()
    elif cmd == "git":
        cmd_git()
    elif cmd == "hud":
        cmd_hud()
    elif cmd in ["test", "self-test", "verify"]:
        cmd_test()
    elif cmd == "vision":
        cmd_vision()
    elif cmd == "voice":
        cmd_voice(sys.argv[2:])
    elif cmd == "memory":
        cmd_memory(sys.argv[2:])
    elif cmd == "intent":
        cmd_intent(sys.argv[2:])
    elif cmd == "chat":
        prompt = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else "diagnose system"
        cmd_chat(prompt)
    elif cmd == "compact":
        res = send_unix_request(MCP_SOCK, {"action": "call_tool", "name": "memory.compact", "args": {}})
        print(res.get("result") if res else "Compacting memory...")
    else:
        cmd_intent(sys.argv[1:])

if __name__ == "__main__":
    main()
