#!/usr/bin/env python3
"""
AetherOS CLI Control Utility (`aetherctl`)
Communicates with the Aether Kernel MCP Daemon (aether-mcpd).
"""

import sys
import os
import json
import socket
import urllib.request
import urllib.error

MCP_SOCKET_PATH = "/run/aether/mcp.sock"
HTTP_URL = "http://127.0.0.1:9090"

def send_unix_request(req):
    if not os.path.exists(MCP_SOCKET_PATH):
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(MCP_SOCKET_PATH)
        s.sendall(json.dumps(req).encode("utf-8"))
        data = s.recv(32768).decode("utf-8")
        s.close()
        return json.loads(data)
    except Exception:
        return None

def send_http_request(endpoint, payload=None):
    url = f"{HTTP_URL}{endpoint}"
    try:
        if payload is not None:
            data = json.dumps(payload).encode("utf-8")
            req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
        else:
            req = urllib.request.Request(url)
        with urllib.request.urlopen(req, timeout=3) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None

