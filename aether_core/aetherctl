#!/usr/bin/env python3
"""
AetherOS CLI Control Utility (`aetherctl`)
Unified control interface for Kernel MCP, Vision, Voice, Memory, and Intent Engines.
"""

import sys
import os
import json
import socket
import urllib.request
import urllib.error

MCP_SOCK = "/run/aether/mcp.sock"
VISION_SOCK = "/run/aether/vision.sock"
VOICE_SOCK = "/run/aether/voice.sock"
MEM_SOCK = "/run/aether/mem.sock"
INTENT_SOCK = "/run/aether/intent.sock"

def send_unix_request(sock_path, req, timeout=2.0):
    if not os.path.exists(sock_path):
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(sock_path)
        s.sendall(json.dumps(req).encode("utf-8"))
        data = s.recv(32768).decode("utf-8")
        s.close()
        return json.loads(data)
    except Exception:
        return None

