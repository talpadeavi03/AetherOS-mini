def cmd_vision():
    res = send_unix_request(VISION_SOCK, {"action": "status"})
    if not res:
        print("[aetherctl] Error: aether-visiond is not responding.")
        return
    print(json.dumps(res, indent=2))

def cmd_voice(subargs):
    if not subargs or subargs[0] == "status":
        res = send_unix_request(VOICE_SOCK, {"action": "status"})
        print(json.dumps(res, indent=2))
    elif subargs[0] == "speak":
        text = " ".join(subargs[1:]) if len(subargs) > 1 else "AetherOS sensory core online."
        res = send_unix_request(VOICE_SOCK, {"action": "speak", "text": text})
        print(f"[*] Voice output: {text}")
        if res:
            print(f"[*] Status: {res.get('status')}")
    elif subargs[0] == "mode":
        mode = subargs[1] if len(subargs) > 1 else "interactive"
        res = send_unix_request(VOICE_SOCK, {"action": "set_mode", "mode": mode})
        print(f"[*] Mode updated: {res}")

def cmd_memory(subargs):
    if not subargs or subargs[0] == "stats":
        res = send_unix_request(MEM_SOCK, {"action": "stats"})
        print(json.dumps(res, indent=2))
    elif subargs[0] == "store":
        if len(subargs) < 3:
            print("Usage: aetherctl memory store <category> <content...>")
            return
        cat = subargs[1]
        content = " ".join(subargs[2:])
        res = send_unix_request(MEM_SOCK, {"action": "store", "category": cat, "key": "cli", "content": content})
        print(f"[*] Memory stored: {res}")
    elif subargs[0] == "search":
        query = " ".join(subargs[1:]) if len(subargs) > 1 else ""
        res = send_unix_request(MEM_SOCK, {"action": "search", "query": query, "limit": 5})
        print(json.dumps(res, indent=2))
    elif subargs[0] == "graph":
        res = send_unix_request(MEM_SOCK, {"action": "graph"})
        print(json.dumps(res, indent=2))

