[Unit]
Description=AetherOS Micro-Intent Router & Grammar Engine
After=network.target aether-mcp.service aether-vision.service aether-voice.service aether-memory.service
Wants=aether-mcp.service aether-vision.service aether-voice.service aether-memory.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/bin/aether-intentd
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
